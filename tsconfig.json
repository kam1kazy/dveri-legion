{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/features/": [
        "./src/features/*"
      ],
      "@/shared/": [
        "./src/shared/*"
      ],
      "@/entities/": [
        "./src/entities/*"
      ],
      "@/ui/": [
        "./src/shared/ui/*"
      ],
      "@/lib/": [
        "./src/shared/lib/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "src/types/globals.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
